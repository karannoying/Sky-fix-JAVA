<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.skyfix</groupId>
  <artifactId>skyfix</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>SKYFIX</name>
  <description>
    High-altitude balloon landing-footprint prediction with in-flight parameter estimation.
    CSE2006 Programming in Java, VIT Bhopal University.
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Plumbing only. No scientific library may appear here (CLAUDE.md rule 1). -->
    <sqlite.version>3.47.1.0</sqlite.version>
    <jackson.version>2.18.2</jackson.version>
    <xchart.version>3.8.8</xchart.version>
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.27.3</assertj.version>

    <surefire.version>3.5.2</surefire.version>
    <jacoco.version>0.8.12</jacoco.version>
    <!-- Excluded by default; enabled by -Pperf (T-P*, T-R1). -->
    <excluded.test.groups>perf</excluded.test.groups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.knowm.xchart</groupId>
      <artifactId>xchart</artifactId>
      <version>${xchart.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <excludedGroups>${excluded.test.groups}</excludedGroups>
          <!-- Tests must never reach the network (CLAUDE.md rule 2). -->
          <systemPropertyVariables>
            <skyfix.offline>true</skyfix.offline>
            <java.util.logging.config.file>
              ${project.basedir}/src/test/resources/logging.properties
            </java.util.logging.config.file>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <!-- T-M1: build gate, NFR-4. Bound to verify so `mvn test` stays fast. -->
          <execution>
            <id>check-core-coverage</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <includes>
                    <include>com.skyfix.core.*</include>
                    <include>com.skyfix.estimation.*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.skyfix.cli.Main</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Runtime jars next to the artifact so `java -jar` works with no classpath fiddling. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- ./mvnw verify -Pperf : adds timing (T-P*) and reproducibility (T-R1). -->
    <profile>
      <id>perf</id>
      <properties>
        <excluded.test.groups></excluded.test.groups>
        <!--
          Coverage instrumentation is switched OFF for timing runs. JaCoCo attaches a bytecode
          agent that rewrites every class as it loads, and the ensemble's hot loop is exactly the
          kind of tight numerical code it slows most. A T-P1 figure measured under the agent is
          not the figure NFR-1 is about, and reporting one would overstate the cost of the
          ensemble by a wide margin. Run coverage and timing separately: `mvnw verify` for the
          gate, `mvnw verify -Pperf` for the numbers.
        -->
        <jacoco.skip>true</jacoco.skip>
      </properties>
    </profile>
  </profiles>
</project>
